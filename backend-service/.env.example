PORT=5000

# Supabase — from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini AI — from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek AI — from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq — from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily — from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# PageIndex — from your PageIndex dashboard
PAGEINDEX_API_KEY=your_pageindex_api_key_here

# Frontend URL (used for CORS) — set to your Vercel URL in production
FRONTEND_URL=https://lawlify-ai.vercel.app

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Tally Form Integration
TALLY_API_KEY=your_tally_api_key_here
