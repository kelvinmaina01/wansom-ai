# ——————————————————————————————————————————————————————————————————————————————————————
# LAWLIFY AI — MASTER ENVIRONMENT VARIABLES (EXAMPLE)
# ——————————————————————————————————————————————————————————————————————————————————————
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file with real secrets to version control.
# ——————————————————————————————————————————————————————————————————————————————————————

# ——— FRONTEND (Vite) ———
# These must start with VITE_ to be accessible in the frontend code.

# Firebase Configuration Removed

# Backend API URL (use localhost for development, update to your deployed backend URL in production)
VITE_BACKEND_URL=http://localhost:5000


# ——— BACKEND (Server) ———
# These are for the backend service and should NOT be exposed to the frontend.

# Server Port
PORT=5000

# Firebase Admin Removed

# Supabase (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://ygtnjiwdrfldpsmakaqo.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend-accessible Supabase keys (must start with VITE_)
VITE_SUPABASE_URL=https://ygtnjiwdrfldpsmakaqo.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth Keys
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Service Keys (Get from respective dashboards)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PAGEINDEX_API_KEY=your_pageindex_api_key_here

# Frontend URL (Used for CORS and redirects)
FRONTEND_URL=https://lawlify-ai.vercel.app
